---
import Lines from '../../components/Lines.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import Layout from '../../layouts/Layout.astro';
import { resolveImage } from '../../lib/images';
import { projects, type Block } from '../../lib/projects';
import MarkdownIt from 'markdown-it';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

type Project = (typeof projects)[number];

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const d = project.detail;
const cover = resolveImage(project.image ?? '');
// Contenu de confiance, écrit dans l'Admin : HTML gardé, retours à la ligne conservés comme avec <Lines>.
const md = new MarkdownIt({ html: true, breaks: true });

// Un Texte suivi de Features forme un seul groupe, affiché côte à côte.
const groups: Block[][] = [];
for (const block of d.blocs) {
  const last = groups.at(-1);
  if (block.discriminant === 'features' && last?.length === 1 && last[0].discriminant === 'texte') last.push(block);
  else groups.push([block]);
}
const isCarousel = d.blocs.some((block) => block.discriminant === 'images' && block.value.images.length > 1);
---

<Layout
    active="projets"
    title={`${project.title} | Projets - Louis MOULINET`}
    description={(project.description ?? '').slice(0, 160)}
    ogTitle={`${project.title} | Louis MOULINET`}
    ogDescription={project.description}
    ogType="article"
    ogImage={typeof cover === 'string' ? cover : cover.src}
>
    <main class="pt-24 px-8 max-w-7xl">
        <!-- Hero Section -->
        <header class="detail-hero mb-20">
            <div class="md:col-span-8">
                <span class="font-label text-primary font-semibold tracking-widest uppercase text-xs mb-4 block">
                    {project.number} / BTS-SIO / {project.category}
                </span>
                <h1 class="font-headline text-6xl font-bold tracking-tighter leading-none mb-6">
                    {project.title}
                </h1>
                <p class="font-body text-xl text-on-surface-variant max-w-xl leading-relaxed">
                    {project.description}
                </p>
            </div>
            <div class="md:col-span-4 flex justify-end">
                <div class="detail-hero-meta">
                    <span class="detail-hero-meta-item">Statut : {d.status}</span>
                    <span class="detail-hero-meta-item">Stack : {d.stack}</span>
                    <span class="detail-hero-meta-item">Année : {d.year}</span>
                </div>
            </div>
        </header>
        {groups.map((group, g) => {
            const [block] = group;
            const first = g === 0;
            if (block.discriminant === 'texte' || block.discriminant === 'features') return (
                <div class="detail-narrative">
                    {group.map((block) => block.discriminant === 'texte' ? (
                        <div class={group.length > 1 ? 'md:col-span-5' : 'md:col-span-10'}>
                            <h2 class="font-headline text-3xl font-bold mb-8 flex items-center gap-3">
                                <span class="w-8 h-px bg-primary"></span> {block.value.titre}
                            </h2>
                            <div class="space-y-6 text-on-surface-variant leading-loose font-light" set:html={md.render(block.value.contenu ?? '')} />
                        </div>
                    ) : block.discriminant === 'features' && (
                        <div class="md:col-span-7 feature-grid">
                            {block.value.cartes.map((card) => card.style === 'accent' ? (
                                <div class="feature-card feature-card--primary glass-btn shadow-lg" style="display:inline">
                                    <span class="material-symbols-outlined mb-4 opacity-70">{card.icone}</span>
                                    <h3 class="font-headline font-bold text-lg mb-2">{card.titre}</h3>
                                    <p class="text-sm font-medium opacity-90"><Lines text={card.description} /></p>
                                </div>
                            ) : (
                                <div class={card.style === 'large' ? 'glass-surface small-glass feature-card feature-card--span-2' : 'glass-surface small-glass feature-card'}>
                                    <span class="material-symbols-outlined text-primary mb-4">{card.icone}</span>
                                    <h3 class="font-headline font-bold text-lg mb-2">{card.titre}</h3>
                                    <p class="text-sm text-on-surface-variant font-medium"><Lines text={card.description} /></p>
                                </div>
                            ))}
                        </div>
                    ))}
                </div>
            );
            if (block.discriminant === 'images') {
                const images = block.value.images.filter((src): src is string => Boolean(src));
                return (
                    <section>
                        {images.length > 1 ? (
                            <div class="detail-image-banner glass-surface big-glass detail-carousel">
                                <div class="carousel-track">
                                    {images.map((src, i) => (
                                        <ProjectImage layout="banner" alt={block.value.alt}
                                            class={i === 0 ? 'carousel-slide active' : 'carousel-slide'}
                                            src={src}
                                            loading={i === 0 && first ? 'eager' : 'lazy'}
                                            fetchpriority={i === 0 && first ? 'high' : 'auto'} />
                                    ))}
                                </div>
                                <div class="detail-image-overlay"></div>
                                <button class="carousel-arrow carousel-arrow-left" aria-label="Previous image">&#8249;</button>
                                <button class="carousel-arrow carousel-arrow-right" aria-label="Next image">&#8250;</button>
                            </div>
                        ) : (
                            <div class="detail-image-banner glass-surface big-glass">
                                {images.length === 1 && (
                                    <ProjectImage layout="banner" alt={block.value.alt}
                                        loading={first ? 'eager' : 'lazy'}
                                        fetchpriority={first ? 'high' : 'auto'}
                                        class="w-full h-full transition-all duration-700"
                                        style="transition: filter 0.7s ease; position: relative; object-fit: contain;"
                                        onmouseover="this.style.filter='grayscale(0)'"
                                        onmouseout="this.style.filter='grayscale(100%)'"
                                        src={images[0]} />
                                    <div class="detail-image-overlay"></div>
                                )}
                            </div>
                        )}
                    </section>
                );
            }
            if (block.discriminant === 'code') return (
                <section class="mb-32">
                    <div class="tech-spec-section">
                        <div class="tech-spec-sidebar">
                            <h2 class="font-headline text-3xl font-bold mb-6">Architecture Technique</h2>
                            <p class="text-on-surface-variant mb-8 font-body">
                                Extrait de code principal illustrant le modèle d'implémentation clé de ce projet.
                            </p>
                            <div class="flex flex-wrap gap-2">
                                {block.value.tags.map((tag) => (
                                    <span class="tech-tag-pill">{tag}</span>
                                ))}
                            </div>
                        </div>
                        <div class="tech-spec-code">
                            <div class="glass-surface shadow-lg code-block-wrap">
                                <div class="code-block-header">
                                    <span>{block.value.fichier}</span>
                                    <span>{block.value.version}</span>
                                </div>
                                <pre class="leading-relaxed text-on-surface-variant font-bold">{block.value.code}</pre>
                            </div>
                        </div>
                    </div>
                </section>
            );
            return (
                <section class="detail-secondary-images">
                    <div class="bg-surface-container-low aspect-square overflow-hidden">
                        {block.value.image && (
                            <ProjectImage layout="square" alt={block.value.alt}
                                class="w-full h-full object-cover mix-blend-multiply opacity-80"
                                src={block.value.image} />
                        )}
                    </div>
                    <div class="detail-number-card">
                        <span class="font-headline text-5xl font-bold mb-4">{project.number}</span>
                        <p class="font-body text-xl text-on-surface-variant" style="font-weight:500;">
                            <Lines text={block.value.texte} />
                        </p>
                    </div>
                </section>
            );
        })}
        <!-- Navigation between projects -->
        <nav class="project-nav">
            <div>
                {prev && (
                    <a href={`/projets/${prev.slug}`}
                        class="group flex items-center gap-3 font-headline font-bold uppercase tracking-tight hover:text-primary transition-colors">
                        <span class="material-symbols-outlined group-hover:-translate-x-1 transition-transform">arrow_back</span>
                        <span class="text-sm">{prev.title}</span>
                    </a>
                )}
            </div>
            <a href="/projets" class="font-mono text-xs text-outline uppercase tracking-widest hover:text-primary transition-colors">
                Tous les Projets
            </a>
            <div>
                {next && (
                    <a href={`/projets/${next.slug}`}
                        class="group flex items-center gap-3 font-headline font-bold uppercase tracking-tight hover:text-primary transition-colors">
                        <span class="text-sm">{next.title}</span>
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </a>
                )}
            </div>
        </nav>
    </main>
    {isCarousel && (
        <script is:inline>
            (function () {
                'use strict';
                document.querySelectorAll('.detail-carousel').forEach(function (carousel) {
                    const slides = carousel.querySelectorAll('.carousel-slide');
                    if (slides.length === 0) return;

                    var currentIndex = 0;
                    var intervalId = setInterval(autoAdvance, 10000);

                    function goToSlide(index) {
                        for (var i = 0; i < slides.length; i++) {
                            slides[i].classList.toggle('active', i === index);
                        }
                        currentIndex = index;
                    }

                    function autoAdvance() {
                        var next = (currentIndex + 1) % slides.length;
                        goToSlide(next);
                    }

                    function prevSlide() {
                        var prev = (currentIndex - 1 + slides.length) % slides.length;
                        goToSlide(prev);
                        resetTimer();
                    }

                    function nextSlide() {
                        var next = (currentIndex + 1) % slides.length;
                        goToSlide(next);
                        resetTimer();
                    }

                    function resetTimer() {
                        clearInterval(intervalId);
                        intervalId = setInterval(autoAdvance, 10000);
                    }

                    var leftArrow = carousel.querySelector('.carousel-arrow-left');
                    var rightArrow = carousel.querySelector('.carousel-arrow-right');

                    if (leftArrow) leftArrow.addEventListener('click', prevSlide);
                    if (rightArrow) rightArrow.addEventListener('click', nextSlide);
                });
            })();
        </script>
    )}
</Layout>
